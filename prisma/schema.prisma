// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ──────────────────────────────────────────────
// NextAuth.js required models (Prisma adapter)
// ──────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ──────────────────────────────────────────────
// Application models
// ──────────────────────────────────────────────

model Room {
  id         String    @id @default(cuid())
  name       String
  calendarId String
  provider   String    @default("google")
  bookings   Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Booking {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  eventId   String   @unique
  startTime DateTime
  endTime   DateTime

  createdAt DateTime @default(now())

  @@index([roomId, startTime, endTime])
}

model Employee {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  department String?
  workStatus String   @default("in_office")
  visits     Visit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Visit {
  id                String   @id @default(cuid())
  visitorName       String
  company           String?
  hostId            String
  host              Employee @relation(fields: [hostId], references: [id], onDelete: Cascade)
  checkedInAt       DateTime @default(now())
  hostNotified      Boolean  @default(false)
  notificationError String?

  @@index([hostId, checkedInAt])
}
