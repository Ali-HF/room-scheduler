# Environment variables required for room-scheduler

# Supabase Database Connections
DATABASE_URL="" # Connection-pooling URL (port 6543, for app queries)
DIRECT_URL=""   # Direct connection URL (port 5432, required for migrations)

# NextAuth / Auth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Token Application-Level Encryption (AES-256-GCM - 32 bytes / 64 hex characters)
ENCRYPTION_KEY=""

# Google OAuth Provider (requires https://www.googleapis.com/auth/calendar.readonly scope)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Supabase Client & API
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Admin Access Control (comma-separated emails)
ADMIN_EMAILS=""

# Restricted Employee Domain (e.g. clientcompany.com, leave blank for all)
ALLOWED_EMAIL_DOMAIN=""
